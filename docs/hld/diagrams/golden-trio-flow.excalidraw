      "groupIds": [],
      "index": "aa",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "question, paraphrases\n   -> embedded; matched by similarity (A5, B3)\n\nscope_all, brands\n   -> Brand filter (B1); all-Brand = Executives only\n\nstatus\n   -> only 'active' is searched (B1)\n\nsql\n   -> template for the agent (B4);\n      re-run through the query guard (B5)\n\nmethod_summary\n   -> agent prompt: HOW to analyse (B4)\n\nparameters\n   -> allowed numbers, e.g. 90-day churn window\n\ntables_used, question_type\n   -> metadata\n\nsource_uri, approved_by\n   -> audit only, never sent to the agent\n\nthe original report\n   -> NOT stored; only linked by source_uri",
      "roughness": 1,
      "roundness": null,
      "seed": 403502274,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "question, paraphrases\n   -> embedded; matched by similarity (A5, B3)\n\nscope_all, brands\n   -> Brand filter (B1); all-Brand = Executives only\n\nstatus\n   -> only 'active' is searched (B1)\n\nsql\n   -> template for the agent (B4);\n      re-run through the query guard (B5)\n\nmethod_summary\n   -> agent prompt: HOW to analyse (B4)\n\nparameters\n   -> allowed numbers, e.g. 90-day churn window\n\ntables_used, question_type\n   -> metadata\n\nsource_uri, approved_by\n   -> audit only, never sent to the agent\n\nthe original report\n   -> NOT stored; only linked by source_uri",
      "textAlign": "left",
      "updated": 1794916201457,
      "version": 1,
      "versionNonce": 1534119180,
      "verticalAlign": "top"
    },
