      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Production: Cloud SQL Postgres (+ pgvector) holds all app state (ADR 0002). Prototype: SQLite behind the same ports; only adapters change. Dashed white cells = reads. The agent never writes to BigQuery.",
      "roughness": 1,
      "roundness": null,
      "seed": 442157406,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Production: Cloud SQL Postgres (+ pgvector) holds all app state (ADR 0002). Prototype: SQLite behind the same ports; only adapters change. Dashed white cells = reads. The agent never writes to BigQuery.",
      "textAlign": "left",
      "updated": 1794498488365,
      "version": 1,
      "versionNonce": 1978793416,
      "verticalAlign": "top"
    },
    {
      "id": "st2",
      "type": "text",
      "x": 40,
      "y": 92,
      "width": 2285,
      "height": 20,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
