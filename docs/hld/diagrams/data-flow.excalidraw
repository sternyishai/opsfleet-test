      "index": "a2",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "The four timing columns show production. The prototype has no Pub/Sub or scheduler: entity extraction runs at save time, and the event and scheduled jobs are not built. No code exists yet: the scope tag says what the prototype will build.",
      "roughness": 1,
      "roundness": null,
      "seed": 1623388984,
      "strokeColor": "#495057",
