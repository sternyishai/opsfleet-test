      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "state      AgentState, saved after every node\n           (SQLite checkpointer, thread_id = conversation_id)\nruntime    TurnRuntime: user_id, outbound (never saved)\nusers / personas / profiles / reports / trios\n           -> SQLite app.db adapters\nwarehouse  -> BigQuery (read-only, behind QueryGuard)\nllm        -> Gemini, per-step model + fallback\npii        -> regex filter",
      "roughness": 1,
      "roundness": null,
      "seed": 695547885,
      "strokeColor": "#343a40",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "state      AgentState, saved after every node\n           (SQLite checkpointer, thread_id = conversation_id)\nruntime    TurnRuntime: user_id, outbound (never saved)\nusers / personas / profiles / reports / trios\n           -> SQLite app.db adapters\nwarehouse  -> BigQuery (read-only, behind QueryGuard)\nllm        -> Gemini, per-step model + fallback\npii        -> regex filter",
      "textAlign": "left",
      "updated": 1794824631789,
      "version": 1,
      "versionNonce": 1886464191,
      "verticalAlign": "top"
    },
