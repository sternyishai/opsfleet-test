# Copy to .env and fill in the two required values (README.md § Setup).
# Read at start-up by src/agent/config.py; `docker run --env-file .env` passes the same file.

# --- required -------------------------------------------------------------------------------
# Gemini, from Google AI Studio (https://aistudio.google.com/apikey). The free tier works.
GOOGLE_API_KEY=
# The Google Cloud project BigQuery bills the queries to (the data is the public
# bigquery-public-data.thelook_ecommerce). Credentials: gcloud application-default login.
BIGQUERY_PROJECT=

# Models: provider:model or a bare Gemini ID, one setting per model call. Only the router
# and the analyst are required; every other step inherits (config.py, ModelSettings).
MODEL_ROUTER=gemini-3.5-flash-lite
MODEL_ANALYST=gemini-3.6-flash
MODEL_ANALYST_FALLBACK=gemini-3.5-flash-lite

# --- optional -------------------------------------------------------------------------------
# USD per million tokens (input, output) by model, for the cost line of /stats.
# MODEL_PRICES={"gemini-3.6-flash": [0.50, 3.00], "gemini-3.5-flash-lite": [0.30, 2.50]}

# Phoenix (`uvx arize-phoenix serve`). Traces always go to traces/*.jsonl; Phoenix is a
# second sink, used only if it answers at start-up. Empty turns it off.
# PHOENIX_ENDPOINT=http://127.0.0.1:6006
# Developer machines only: full prompts and tool input/output (rows included) in Phoenix.
# PHOENIX_FULL_CONTENT=false

# Web UI: the User picker (development only; agent web must then bind 127.0.0.1).
# WEB_DEV_IDENTITY=true
# The built UI, served at / next to /api (`pnpm --dir web build`). The Docker image sets it.
# WEB_UI_DIR=web/dist
